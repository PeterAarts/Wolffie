              "max": 90,
              "default": 35,
              "cols": 2
            },
            {
              "key": "latitude",
              "component": "text",
              "label": "modules.solarForecast.fields.latitude.label",
              "description": "modules.solarForecast.fields.latitude.description",
              "placeholder": "modules.solarForecast.fields.latitude.placeholder",
              "cols": 2
            },
            {
              "key": "longitude",
              "component": "text",
              "label": "modules.solarForecast.fields.longitude.label",
              "description": "modules.solarForecast.fields.longitude.description",
              "placeholder": "modules.solarForecast.fields.longitude.placeholder",
              "cols": 2
            },
            {
              "key": "azimuth",
              "component": "number",
              "label": "modules.solarForecast.fields.azimuth.label",
              "description": "modules.solarForecast.fields.azimuth.description",
              "min": 0,
              "max": 360,
              "default": 0,
              "cols": 2
            }
          ]
        }
      ]
    },
    {
      "title": "modules.solarForecast.groups.fetch.title",
      "sections": [
        {
          "fields": [
            {
              "key": "fetch_interval_hours",
              "component": "number",
              "label": "modules.solarForecast.fields.fetch_interval_hours.label",
              "description": "modules.solarForecast.fields.fetch_interval_hours.description",
              "min": 1,
              "max": 24,
              "default": 15,
              "cols": 4
            },
            {
              "key": "forecast_days",
              "component": "number",
              "label": "modules.solarForecast.fields.forecast_days.label",
              "description": "modules.solarForecast.fields.forecast_days.description",
              "min": 1,
              "max": 30,
              "default": 7,
              "cols": 4
            }
          ]
        }
      ]
    },
    {
      "title": "modules.solarForecast.groups.status.title",
      "sections": [
        {
          "component": "info-panel",
          "data": {
            "endpoint": "/api/solar-forecast/status",
            "dynamic": true,
            "items": [
              {
                "label": "modules.solarForecast.status.lastFetch",
                "field": "lastFetch",
                "template": {
                  "type": "datetime"
                }
              },
              {
                "label": "modules.solarForecast.status.lastFetchRecords",
                "field": "lastFetchRecords"
              },
              {
                "label": "modules.solarForecast.status.status",
                "field": "healthy",
                "template": {
                  "type": "status-badge"
                }
              },
              {
                "label": "modules.solarForecast.status.avgAccuracy",
                "field": "avgAccuracy",
                "template": {
                  "type": "percentage"
                }
              }
            ]
          }
        }
      ]
    }
  ]
