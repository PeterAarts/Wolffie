{
  "id": "day-ahead-prices",
  "name": "Day-Ahead Electricity Prices",
  "version": "1.0.5",
  "description": "Hourly electricity prices from Energy Charts API (Fraunhofer ISE) - No registration required!",
  "type": "collector",
  "author": "WattsOn",
  "enabled": true,

  "capabilities": {
    "dataCollection": true,
    "api": true
  },

  "schedules": [
    {
      "name": "daily_prices",
      "cron": "0 14 * * *",
      "description": "Fetch day-ahead prices at 14:00 (after publication)"
    }
  ],
  "dependencies": {
    "axios": "^1.6.0"
  },
  "settings": {
    "schema": "settings_schema.json"
  },
  "routes": {
    "enabled": true,
    "prefix": "/api/day-ahead-prices",
    "file": "routes/index.js"
  },
  "collector": {
    "service": "services/collector.js",
    "enabled": true,
    "interval": 3600000,
    "scheduled": true
  },
  "database": {
    "tables": [
      "day_ahead_prices"
    ]
  },
  "api": {
    "provider": "Energy Charts (Fraunhofer ISE)",
    "authentication": "None - Free API",
    "documentation": "https://api.energy-charts.info/",
    "advantages": [
      "No API token required",
      "No registration needed",
      "Simple JSON format",
      "Reliable data source"
    ]
  }
}