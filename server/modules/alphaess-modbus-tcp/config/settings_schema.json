{
  "groups": [
    {
      "title": "ModBus TCP Configuratie",
      "sections": [
        {
          "fields": [
            { "key": "enabled", "component": "switch", "label": "ModBus TCP Inschakelen", "cols": 2}
          ]
        },
        {
          "title": "Netwerk Instellingen",
          "description": "De netwerkgegevens van je AlphaESS omvormer",
          "fields": [
            { "key": "host", "component": "text", "label": "IP Adres", "cols": 3, "placeholder": "192.168.1.158", "required": true },
            { "key": "port", "component": "number", "label": "Poort", "cols": 3, "default": 502, "required": true }
          ]
        },
        {
          "title": "Modbus Protocol",
          "description": "Specifieke protocol instellingen voor AlphaESS",
          "fields": [
            { "key": "unit_id", "component": "number", "label": "Unit ID (Slave ID)", "cols": 2, "default": 85, "required": true },
            { "key": "poll_interval", "component": "number", "label": "Poll Interval (ms)", "cols": 2, "default": 20000, "suffix": " ms" },
            { "key": "timeout", "component": "number", "label": "Timeout (ms)", "cols": 2, "default": 2000, "suffix": " ms" }
          ]
        },
        {
          "title": "Batterij instellingen",
          "fields": [
            { "key": "MinSoC ", "component": "number", "label": "Minimal SoC", "cols": 2, "default": 30, "suffix": " %","required": true },
            { "key": "MaxSoC", "component": "number", "label": "Maximale SoC", "cols": 2, "default": 98, "suffix": " %","required": true },
            { "key": "UPS", "component": "boolean", "label": "use UPS Reserve", "cols": 2, "default": true}
          ]
        }
      ]
    }
  ],
  "actions": [
    { "id": "test_modbus", "label": "Test Verbinding", "icon": "pi-refresh", "endpoint": "/api/alphaess-modbus-tcp/test" }
  ]
}