{
  "i18nKeys": true,
  "groups": [
    {
      "title": "modules.homeWizard.groups.general.title",
      "sections": [
        {
          "fields": [
            {
              "key": "enabled",
              "component": "switch",
              "label": "modules.homeWizard.fields.enabled.label",
              "description": "modules.homeWizard.fields.enabled.description"
            },
            {
              "key": "poll_interval",
              "component": "number",
              "label": "modules.homeWizard.fields.poll_interval.label",
              "description": "modules.homeWizard.fields.poll_interval.description",
              "min": 5,
              "max": 300,
              "default": 10
            }
          ]
        }
      ]
    },
    {
      "title": "modules.homeWizard.groups.devices.title",
      "sections": [
        {
          "component": "table",
          "title": "modules.homeWizard.sections.deviceList.title",
          "data": {
            "endpoint": "/homewizard/devices",
            "columns": [
              {
                "field": "name",
                "header": "modules.homeWizard.columns.name",
                "sortable": true
              },
              {
                "field": "ip_address",
                "header": "modules.homeWizard.columns.ip_address",
                "sortable": true
              },
              {
                "field": "product_type",
                "header": "modules.homeWizard.columns.product_type",
                "sortable": true
              },
              {
                "field": "enabled",
                "header": "modules.homeWizard.columns.enabled",
                "template": {
                  "type": "boolean"
                }
              }
            ],
            "globalActions": [
              {
                "label": "modules.homeWizard.actions.discoverDevices",
                "icon": "pi-search",
                "endpoint": "/homewizard/discover",
                "method": "POST",
                "confirmMessage": "modules.homeWizard.confirms.discover"
              }
            ],
            "rowActions": [
              {
                "label": "modules.homeWizard.actions.edit",
                "icon": "pi-pencil",
                "action": "edit"
              },
              {
                "label": "modules.homeWizard.actions.delete",
                "icon": "pi-trash",
                "action": "delete",
                "confirmMessage": "modules.homeWizard.confirms.deleteDevice"
              }
            ]
          }
        },
        {
          "component": "card-grid",
          "title": "modules.homeWizard.sections.statistics.title",
          "data": {
            "endpoint": "/homewizard/devices/stats",
            "cards": [
              {
                "title": "modules.homeWizard.stats.totalDevices",
                "field": "totalDevices",
                "icon": "pi-box",
                "color": "primary"
              },
              {
                "title": "modules.homeWizard.stats.totalPower",
                "field": "totalPower",
                "icon": "pi-bolt",
                "color": "warning",
                "suffix": " W"
              }
            ]
          }
        }
      ]
    }
  ]
}