{
  "version": "1.1",
  "description": "HomeWizard module — field reference and API route map. Devices are persisted in the device_settings database table, NOT in this file. This file documents the data model and the backend routes consumed by the frontend.",

  "storage": {
    "backend": "MariaDB",
    "table": "device_settings",
    "filter": "WHERE module = 'homewizard'"
  },

  "db_fields": {
    "id":           { "type": "INT AUTO_INCREMENT", "description": "Primary key" },
    "module":       { "type": "VARCHAR(50)",  "value": "homewizard" },
    "name":         { "type": "VARCHAR(255)", "description": "Custom display name (local label set by user)" },
    "ip_address":   { "type": "VARCHAR(45)",  "description": "Device LAN IP address" },
    "port":         { "type": "INT",          "default": 80, "description": "HomeWizard Local API port (almost always 80)" },
    "serial":       { "type": "VARCHAR(100)", "nullable": true, "description": "Device serial from /api endpoint" },
    "product_type": { "type": "VARCHAR(100)", "nullable": true, "description": "e.g. HWE-SKT, HWE-P1" },
    "priority":     { "type": "INT",          "default": 5 },
    "enabled":      { "type": "TINYINT(1)",   "default": 1 }
  },

  "virtual_fields": {
    "stats": {
      "description": "Computed at request time from device_measurements table — NOT stored in device_settings",
      "fields": {
        "firstReadingToday": { "type": "number|null", "unit": "Wh", "description": "First total_power_import_kwh reading after midnight (×1000)" },
        "latestReading":     { "type": "number|null", "unit": "Wh", "description": "Most recent reading today (×1000)" },
        "dailyUsedPower":    { "type": "number|null", "unit": "Wh", "description": "latestReading − firstReadingToday" }
      }
    }
  },

  "api_routes": {
    "base": "/api/homewizard",
    "note": "All routes defined in modules/homewizard/routes/index.js",

    "device_crud": {
      "description": "Read/write device_settings table via deviceService.js",
      "endpoints": [
        {
          "method": "GET",  "path": "/devices",
          "description": "List all devices, each enriched with daily usage stats"
        },
        {
          "method": "GET",  "path": "/devices/stats",
          "description": "Aggregate counts — declared BEFORE /devices/:id to avoid route shadowing"
        },
        {
          "method": "GET",  "path": "/devices/:id",
          "description": "Single device with stats"
        },
        {
          "method": "POST", "path": "/devices",
          "description": "Add a new device",
          "body": {
            "name":         "string (optional)",
            "ip_address":   "string (required)",
            "port":         "number (optional, default 80)",
            "serial":       "string (optional)",
            "product_type": "string (optional)",
            "priority":     "number (optional, default 5)",
            "enabled":      "boolean (optional, default true)"
          }
        },
        {
          "method": "PUT",  "path": "/devices/:id",
          "description": "Update DB record only — does NOT push live settings to device",
          "body": "any subset of: name, ip_address, port, serial, product_type, priority, enabled"
        },
        {
          "method": "DELETE", "path": "/devices/:id",
          "description": "Remove device from DB and reload collector"
        }
      ]
    },

    "live_device_control": {
      "description": "Real-time read/write to the physical device via services/api.js (HomeWizard Local API v1)",
      "endpoints": [
        {
          "method": "GET",  "path": "/devices/:id/state",
          "hw_endpoint": "GET /api/v1/state",
          "description": "Read current power_on and switch_lock from device",
          "response_example": { "power_on": true, "switch_lock": false }
        },
        {
          "method": "PUT",  "path": "/devices/:id/state",
          "hw_endpoint": "PUT /api/v1/state",
          "description": "Set power_on and/or switch_lock on the physical device",
          "body": { "power_on": "boolean (optional)", "switch_lock": "boolean (optional)" },
          "frontend_use": "Switch lock toggle in Control view"
        },
        {
          "method": "GET",  "path": "/devices/:id/system",
          "hw_endpoint": "GET /api/v1/system",
          "description": "Read system info: status_led_brightness_pct, firmware, wifi RSSI, uptime"
        },
        {
          "method": "GET",  "path": "/devices/:id/data",
          "hw_endpoint": "GET /api/v1/data",
          "description": "Live measurement data: power_w, total_power_import_kwh, voltage, current"
        },
        {
          "method": "POST", "path": "/devices/:id/identify",
          "hw_endpoint": "PUT /api/v1/identify",
          "description": "Blink LED for physical identification"
        }
      ]
    },

    "discovery": {
      "endpoints": [
        {
          "method": "POST", "path": "/discover",
          "description": "Scan local network for HomeWizard devices and persist new ones"
        }
      ]
    },

    "collector": {
      "endpoints": [
        {
          "method": "GET", "path": "/collector/status",
          "description": "Collector health: deviceCount, lastCollection, lastError, consecutiveErrors"
        }
      ]
    },

    "module_settings": {
      "description": "Module-level config via settingsService (not per-device)",
      "endpoints": [
        { "method": "GET", "path": "/settings", "description": "Read module settings" },
        { "method": "PUT", "path": "/settings",  "description": "Update module settings", "body": { "settings": "object" } }
      ]
    }
  },

  "frontend_field_mapping": {
    "description": "How Control.vue fields map to backend routes",
    "fields": {
      "name":                  { "storage": "DB",       "route": "PUT /homewizard/devices/:id",        "db_field": "name" },
      "ip_address":            { "storage": "DB",       "route": "PUT /homewizard/devices/:id",        "db_field": "ip_address" },
      "enabled":               { "storage": "DB",       "route": "PUT /homewizard/devices/:id",        "db_field": "enabled" },
      "port":                  { "storage": "DB",       "route": "PUT /homewizard/devices/:id",        "db_field": "port" },
      "dailyUsedPower":        { "storage": "Computed", "route": "GET /devices",            "source": "device_measurements table via deviceService.getDailyStats()" },
      "brightness":            { "storage": "Device",   "route": "PUT /homewizard/devices/:id/state", "hw_field": "brightness","type": "range","min": 0,"max": 255},
      "power_on":              { "storage": "Device",   "route": "PUT /homewizard/devices/:id/state",  "hw_field": "power_on","type": "boolean"},
      "switch_lock":           { "storage": "Device",   "route": "PUT /homewizard/devices/:id/state",  "hw_field": "switch_lock","type": "boolean"}
    }
  }
}