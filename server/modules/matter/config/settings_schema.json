{
  "i18nKeys": true,
  "groups": [
    {
      "title": "modules.matter.groups.controller.title",
      "sections": [
        {
          "fields": [
            {
              "key": "enabled",
              "component": "switch",
              "label": "modules.matter.fields.enabled.label",
              "description": "modules.matter.fields.enabled.description"
            },
            {
              "key": "poll_interval",
              "component": "number",
              "label": "modules.matter.fields.poll_interval.label",
              "min": 5,
              "max": 60,
              "default": 15
            }
          ]
        },
        {
          "component": "info-panel",
          "title": "modules.matter.sections.fabricStatus.title",
          "data": {
            "endpoint": "/matter/collector/status",
            "dynamic": true,
            "items": [
              {
                "label": "modules.matter.status.controllerStatus",
                "field": "isRunning",
                "template": {
                  "type": "status-badge"
                }
              },
              {
                "label": "modules.matter.status.activeNodes",
                "field": "deviceCount"
              },
              {
                "label": "modules.matter.status.lastDataSync",
                "field": "lastCollectionTime",
                "template": {
                  "type": "datetime"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "title": "modules.matter.groups.devices.title",
      "sections": [
        {
          "component": "table",
          "title": "modules.matter.sections.nodes.title",
          "data": {
            "endpoint": "/matter/devices",
            "columns": [
              {
                "field": "name",
                "header": "modules.matter.columns.name",
                "sortable": true
              },
              {
                "field": "serial",
                "header": "modules.matter.columns.nodeId",
                "sortable": true
              },
              {
                "field": "product_type",
                "header": "modules.matter.columns.deviceType"
              },
              {
                "field": "enabled",
                "header": "modules.matter.columns.status",
                "template": {
                  "type": "boolean"
                }
              }
            ],
            "globalActions": [
              {
                "label": "modules.matter.actions.commission",
                "icon": "pi-plus",
                "endpoint": "/matter/commission",
                "method": "POST",
                "inputs": [
                  {
                    "key": "pairingCode",
                    "label": "modules.matter.inputs.pairingCode",
                    "type": "text"
                  }
                ],
                "confirmMessage": "modules.matter.confirms.commission"
              }
            ],
            "rowActions": [
              {
                "label": "modules.matter.actions.identify",
                "icon": "fa-eye",
                "action": "identify"
              },
              {
                "label": "modules.matter.actions.delete",
                "icon": "fa-trash",
                "action": "delete",
                "confirmMessage": "modules.matter.confirms.unpair"
              }
            ]
          }
        }
      ]
    }
  ]
}