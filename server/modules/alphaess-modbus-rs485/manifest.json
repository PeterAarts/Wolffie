{
  "id": "alphaess-modbus-rs485",
  "name": "AlphaESS ModBus RS485",
  "version": "1.0.0",
  "description": "AlphaESS inverter communication via ModBus RS485 serial connection",
  "author": "WattsOn",
  "type": "data-collector",
  
  "capabilities": {
    "dataCollection": true,
    "api": true,
    "ui": true
  },

  "collector": {
    "enabled": false,
    "interval": 10000,
    "priority": 10,
    "description": "Collects real-time data via RS485 serial every 10 seconds"
  },

  "routes": {
    "enabled": true,
    "prefix": "/api/alphaess-modbus-rs485",
    "description": "ModBus RS485 configuration and diagnostics"
  },

  "settings": {
    "component": "AlphaESSModbusRS485Settings",
    "schema": "settings-schema.js"
  },

  "dependencies": {
    "node": ">=18.0.0",
    "serialport": "^12.0.0"
  },

  "config": {
    "required": ["port", "baudrate", "slave_id"],
    "optional": ["timeout", "poll_interval"]
  }
}