{
  "id": "alphaess-cloud",
  "name": "AlphaESS Cloud API",
  "version": "1.0.5",
  "description": "AlphaESS Cloud API integration for remote data collection",
  "author": "Wolffie",
  "type": "data-collector",
  
  "capabilities": {
    "dataCollection": true,
    "api": true,
    "ui": true
  },
  "services": [
    { "type": "battery:read",              "priority": 15 },
    { "type": "battery:status",            "priority": 15 },
    { "type": "battery:charge-from-grid",  "priority": 15 },
    { "type": "battery:discharge-to-grid", "priority": 15 },
    { "type": "battery:stop",              "priority": 15 },
    { "type": "solar:read",                "priority": 15 },
    { "type": "grid:read",                 "priority": 15 },
    { "type": "home:read",                 "priority": 15  }
  ],

  "collector": {
    "enabled": true,
    "interval": 120000,
    "priority": 1,
    "description": "Collects data from AlphaESS Cloud API every 2 minutes"
  },

  "routes": {
    "enabled": true,
    "prefix": "/api/alphaess-cloud",
    "description": "AlphaESS Cloud API endpoints"
  },

  "settings": {
    "component": "AlphaESSCloudSettings",
    "schema": "settings_schema.json"
  },

  "dependencies": {
    "node": ">=18.0.0"
  },

  "config": {
    "required": ["app_id", "app_secret", "system_sn"],
    "optional": ["endpoint_url", "poll_interval"]
  }
}