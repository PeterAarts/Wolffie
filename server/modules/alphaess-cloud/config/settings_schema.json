{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlphaESS Cloud API Settings",
  "description": "Configuration for AlphaESS Cloud API integration",
  "type": "object",
  "properties": {
    "app_id": {
      "type": "string",
      "title": "Application ID",
      "description": "Your application ID from open.alphaess.com",
      "minLength": 1,
      "ui": {
        "widget": "text",
        "placeholder": "alpha584cdfd6d484ab0c",
        "column": 1,
        "order": 1
      }
    },
    "app_secret": {
      "type": "string",
      "title": "Application Secret",
      "description": "Your application secret key",
      "minLength": 1,
      "ui": {
        "widget": "password",
        "placeholder": "Enter App Secret",
        "column": 2,
        "order": 2,
        "sensitive": true
      }
    },
    "system_sn": {
      "type": "string",
      "title": "System Serial Number",
      "description": "Your AlphaESS system serial number",
      "pattern": "^AL[A-Z0-9]{13}$",
      "minLength": 15,
      "maxLength": 15,
      "ui": {
        "widget": "text",
        "placeholder": "ALD071025031091",
        "column": 3,
        "order": 3
      }
    },
    "endpoint_url": {
      "type": "string",
      "title": "API Endpoint URL",
      "description": "Leave as default unless using alternative endpoint",
      "format": "uri",
      "default": "https://openapi.alphaess.com/api",
      "ui": {
        "widget": "text",
        "placeholder": "https://openapi.alphaess.com/api",
        "column": 1,
        "order": 4,
        "hint": "Leave as default unless using alternative endpoint"
      }
    },
    "poll_interval": {
      "type": "integer",
      "title": "Polling Interval (ms)",
      "description": "How often to collect data from the API",
      "minimum": 10000,
      "maximum": 600000,
      "default": 60000,
      "ui": {
        "widget": "number",
        "placeholder": "60000",
        "column": 2,
        "order": 6,
        "step": 10000,
        "suffix": "ms"
      }
    },
    "enabled": {
      "type": "boolean",
      "title": "Enable Cloud API",
      "description": "Enable or disable Cloud API data collection",
      "default": true,
      "ui": {
        "widget": "checkbox",
        "column": 1,
        "order": 5,
        "label": "Enable Cloud API"
      }
    }
  },
  "required": ["app_id", "app_secret", "system_sn"],
  "ui": {
    "layout": "grid",
    "columns": 3,
    "actions": [
      {
        "type": "test",
        "label": "Test Connection",
        "icon": "pi pi-check-circle",
        "endpoint": "/api/alphaess-cloud/test",
        "successMessage": "Connection successful!",
        "errorMessage": "Connection failed. Please check your credentials."
      }
    ],
    "helpText": "Get credentials from [open.alphaess.com](https://open.alphaess.com) → Developer → My Applications"
  }
}