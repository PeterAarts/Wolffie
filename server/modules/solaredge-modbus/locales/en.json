        "FR": "France (FR)",
        "CH": "Switzerland (CH)",
        "AT": "Austria (AT)",
        "DK1": "Denmark West (DK1)",
        "DK2": "Denmark East (DK2)",
        "NO1": "Norway 1 (NO1)",
        "NO2": "Norway 2 (NO2)",
        "SE1": "Sweden 1 (SE1)",
        "SE2": "Sweden 2 (SE2)",
        "SE3": "Sweden 3 (SE3)",
        "SE4": "Sweden 4 (SE4)"
      }
