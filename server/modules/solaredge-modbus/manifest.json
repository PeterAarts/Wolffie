{
  "id": "solaredge-modbus",
  "name": "SolarEdge-Modbus",
  "version": "1.0.0",
  "description": "Local Modbus TCP integration for SolarEdge HD-Wave inverters",
  "author": "Wolffie",
  "type": "data-collector",
  "capabilities": {
    "dataCollection": true,
    "api": true,
    "ui": true
  },
  "collector": {
    "enabled": true,
    "interval": 20000,
    "priority": 6,
    "description": "Collects real-time power data every 10 seconds"
  },
    "routes": {
    "enabled": true,
    "prefix": "/api/solaredge-modbus",
    "description": "SolarEdge Modbus API endpoints"
  },
  "config": {
    "required": ["host"],
    "optional": ["port", "unit_id"]
  }
}