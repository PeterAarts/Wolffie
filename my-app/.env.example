# Wolffie frontend — my-app/.env.example
#
#   cp .env.example .env.local
#
# .env.local is git-ignored, so your LAN addresses and local paths never reach
# the repository. Every value here has a working default in vite.config.js —
# you only need this file if your setup differs.
#
# ⚠ FRONTEND ONLY. Server secrets (JWT_*, SETTINGS_ENCRYPTION_KEY) belong in
#   server/.env, never here. Anything prefixed VITE_ is compiled into the
#   browser bundle and is public.
#
# ⚠ FILENAME MATTERS. Vite loads .env, .env.local, .env.[mode] and
#   .env.[mode].local. The default mode for `vite dev` is "development", so a
#   file called .env.dev is NOT loaded unless your npm script passes
#   `--mode dev`. Use .env.local and it always loads.

# ── API ─────────────────────────────────────────────────────────────────────

# Base URL the app uses for API calls.
#
# Recommended: leave it relative. The dev server proxies /api to the backend,
# which avoids CORS entirely, and in production the same origin serves both.
VITE_API_BASE_URL=/api

# Absolute form — only when the frontend and backend are on different origins
# and you have CORS configured on the backend. This BYPASSES the dev proxy.
# VITE_API_BASE_URL=http://192.168.1.160:3009/api

# WebSocket endpoint for live dashboard updates.
# Derived from the API target when unset (http -> ws, https -> wss).
# VITE_WS_URL=ws://localhost:3009

# Where the dev server proxies /api and /ws to.
# Only needed when VITE_API_BASE_URL is relative AND the backend is not on
# localhost:3009 — for example a NAS or a Raspberry Pi on your LAN.
# VITE_PROXY_TARGET=http://192.168.1.160:3009

# Port for the Vite dev server. Default 5173.
# VITE_DEV_PORT=5173

# ── Build ───────────────────────────────────────────────────────────────────

# Where `npm run build` writes the production bundle. Default: dist
#
# Set an absolute path to build straight into your web root and skip a copy
# step:
#   Windows:  VITE_OUT_DIR=W:/_wolffie/my-app/dist
#   Linux:    VITE_OUT_DIR=/var/www/wolffie
#
# ⚠ emptyOutDir is enabled — the target folder is WIPED on every build. Never
#   point it at a directory holding anything else.
# VITE_OUT_DIR=dist
