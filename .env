# ============================================================================
# Wolffie — .env configuratie voor Docker!!
# ============================================================================
# Kopieer dit bestand naar .env en vul de waarden in.
# Bewaar .env NOOIT in git — staat al in .gitignore.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3009

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite database pad — moet overeenkomen met het volume in docker-compose.yml
# als deze niet bestaat, wordt deze automatisch aangemaakt bij de eerste run van de server
DB_PATH=/app/data/wolffie.db

# ── Beveiliging ───────────────────────────────────────────────────────────────
# Minimaal 32 willekeurige tekens — verander dit in productie!
# Genereer een veilig secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=---your key ----

# Encryptie sleutel voor gevoelige instellingen (app_id, app_secret, etc.)
# Moet exact 32 tekens lang zijn
SETTINGS_ENCRYPTION_KEY=-your 32 characters ---

# ── Frontend URL ──────────────────────────────────────────────────────────────
# In productie (Docker): zelfde host als de server
# In development: Vite dev server adres
FRONTEND_URL=http://192.168.1.x:3009

# ── FontAwesome Pro (alleen nodig tijdens docker build) ───────────────────────
# Haal je token op via: https://fontawesome.com/account
# Gebruik tijdens build: docker build --build-arg NPM_FONTAWESOME_TOKEN=xxx .
# NPM_FONTAWESOME_TOKEN=--your fontawesome npm token -- 
# if not available free font icons will be used when available

